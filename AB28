-- ==========================================================
-- TRACER
-- ==========================================================
local function spawnTracer(fromWorld, toWorld, color, duration)
    if not Camera then return end
    local fromScreen, fromOn = Camera:WorldToViewportPoint(fromWorld)
    local toScreen, toOn = Camera:WorldToViewportPoint(toWorld)
    if not fromOn or not toOn then return end

    local dx = toScreen.X - fromScreen.X
    local dy = toScreen.Y - fromScreen.Y
    local length = math.sqrt(dx * dx + dy * dy)
    if length < 1 then return end
    local angle = math.deg(math.atan2(dy, dx))

    local line = Instance.new("Frame")
    line.BackgroundColor3 = color or Config.TracerColor
    line.BorderSizePixel = 0
    line.Size = UDim2.new(0, length, 0, 2)
    line.Position = UDim2.new(0, fromScreen.X, 0, fromScreen.Y)
    line.Rotation = angle
    line.ZIndex = 100
    line.Parent = ScreenGui

    local lineCorner = Instance.new("UICorner")
    lineCorner.CornerRadius = UDim.new(1, 0); lineCorner.Parent = line

    local glow = Instance.new("Frame")
    glow.BackgroundColor3 = color or Config.TracerColor
    glow.BackgroundTransparency = 0.7
    glow.BorderSizePixel = 0
    glow.Size = UDim2.new(0, length, 0, 8)
    glow.Position = UDim2.new(0, fromScreen.X, 0, fromScreen.Y - 3)
    glow.Rotation = angle
    glow.ZIndex = 99
    glow.Parent = ScreenGui

    local glowCorner = Instance.new("UICorner")
    glowCorner.CornerRadius = UDim.new(1, 0); glowCorner.Parent = glow

    local fadeTime = duration or Config.TracerTime
    local startTime = tick()

    local conn
    conn = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local alpha = math.clamp(1 - (elapsed / fadeTime), 0, 1)
        if alpha <= 0 then
            line:Destroy(); glow:Destroy()
            if conn then conn:Disconnect() end
            return
        end
        line.BackgroundTransparency = 1 - alpha
        glow.BackgroundTransparency = 1 - (alpha * 0.4)
    end)
end

