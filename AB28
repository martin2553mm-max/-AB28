local function applyMovement()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- Speed
    if Config.SpeedOn then
        pcall(function() hum.WalkSpeed = Config.SpeedValue end)
    end

    -- Jump
    if Config.JumpOn then
        pcall(function()
            hum.UseJumpPower = true
            hum.JumpPower = Config.JumpValue
        end)
    end
end

-- เรียกใช้ทุกครั้งที่ respawn
local function setupCharacter(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    task.wait(0.3)
    if Config.SpeedOn then
        pcall(function() hum.WalkSpeed = Config.SpeedValue end)
    end
    if Config.JumpOn then
        pcall(function()
            hum.UseJumpPower = true
            hum.JumpPower = Config.JumpValue
        end)
    end

    -- กันค่า reset
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if Config.SpeedOn and hum.WalkSpeed ~= Config.SpeedValue then
            pcall(function() hum.WalkSpeed = Config.SpeedValue end)
        end
    end)
    hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if Config.JumpOn and hum.JumpPower ~= Config.JumpValue then
            pcall(function() hum.JumpPower = Config.JumpValue end)
        end
    end)
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
