local function getTargets()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                table.insert(list, { Player = plr, Head = head, Humanoid = hum })
            end
        end
    end
    return list
end

local function getClosestTarget()
    if not Camera then return nil end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, Config.FOVSize

    for _, t in ipairs(getTargets()) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(t.Head.Position)
        if onScreen then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = t
            end
        end
    end
    return closest
end

local function getMyMuzzle()
    local char = LocalPlayer.Character
    if not char then return Camera.CFrame.Position end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local handle = tool:FindFirstChild("Handle")
            if handle then return handle.Position end
        end
    end

    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if rightHand then return rightHand.Position end

    local head = char:FindFirstChild("Head")
    if head then return head.Position end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end

    return Camera.CFrame.Position
end

local function getHeldWeaponName(char)
    if not char then return "หมัด" end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then return obj.Name end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, obj in ipairs(hum:GetChildren()) do
            if obj:IsA("Tool") then return obj.Name end
        end
    end
    return "หมัด"
end

