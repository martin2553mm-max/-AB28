local function attachESP(player)
    local data = espData[player]
    if not data then return end
    local char = player.Character
    if not char then
        data.bb.Parent = nil
        return
    end
    local head = char:FindFirstChild("Head")
    if head then
        data.bb.Adornee = head
        data.bb.Parent = head
    end
end

local function updateESP(player)
    local data = espData[player]
    if not data then return end
    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not head or not hum or not hrp or hum.Health <= 0 then
        data.bb.Enabled = false
        return
    end

    local myChar = LocalPlayer.Character
    local myHrp  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local dist = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0

    if Config.ESPMaxDist > 0 and dist > Config.ESPMaxDist then
        data.bb.Enabled = false
        return
    end

    if data.bb.Adornee ~= head or data.bb.Parent ~= head then
        data.bb.Adornee = head
        data.bb.Parent = head
    end

    data.bb.Enabled = true
    data.bb.MaxDistance = Config.ESPMaxDist > 0 and Config.ESPMaxDist or 1000

    if Config.ESPWeapon then
        local w = getHeldWeaponName(char)
        if w == "หมัด" then
            data.weapon.Text = "👊 หมัด"
            data.weapon.TextColor3 = Color3.fromRGB(255, 220, 100)
        else
            data.weapon.Text = "🔫 " .. w
            data.weapon.TextColor3 = Color3.fromRGB(255, 90, 90)
        end
        data.weapon.Visible = true
    else
        data.weapon.Visible = false
    end

    if Config.ESPName then
        data.name.Text = player.Name
        data.name.TextColor3 = Color3.fromRGB(255, 255, 255)
        data.name.Visible = true
    else
        data.name.Visible = false
    end

    if Config.ESPHealth then
        local maxHp = hum.MaxHealth > 0 and hum.MaxHealth or 100
        local pct = math.clamp(hum.Health / maxHp, 0, 1)
        data.hpBg.Visible = true
        data.hpFill.Size = UDim2.new(pct, 0, 1, 0)
        if pct > 0.6 then
            data.hpFill.BackgroundColor3 = Color3.fromRGB(0, 220, 60)
        elseif pct > 0.3 then
            data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        else
            data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
        end
    else
        data.hpBg.Visible = false
    end

    if Config.ESPDistance then
        data.dist.Text = string.format("[%d studs]  %.0f/%.0f HP",
            math.floor(dist), hum.Health, hum.MaxHealth)
        data.dist.Visible = true
    else
        data.dist.Visible = false
    end
end

local function removeESP(player)
    local d = espData[player]
    if not d then return end
    pcall(function() d.bb:Destroy() end)
    espData[player] = nil
end

local function anyESPOn()
    return Config.ESPName or Config.ESPHealth or Config.ESPDistance or Config.ESPWeapon
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if anyESPOn() then
                if not espData[plr] then createESP(plr) end
                attachESP(plr)
            else
                removeESP(plr)
            end
        end
    end
end

