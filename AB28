-- ⭐ ITEM VACUUM : ดูดไอเทมตกพื้น
-- ==========================================================
local vacuumTargets = {}

-- หาไอเทมที่ตกบนพื้น (Tool / Accessory ที่ไม่ได้อยู่ในมือใคร)
local function findDroppedItems()
    local items = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        -- Tool ที่อยู่ใน Workspace ตรง ๆ = ของตกพื้น
        if obj:IsA("Tool") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                table.insert(items, handle)
            end
        end
        -- Model ที่อาจเป็น drop
        elseif obj:IsA("Model") then
            local primary = obj.PrimaryPart
            if primary and not obj:FindFirstChildOfClass("Humanoid") then
                -- เช็คว่าไม่ได้เป็นตัวละคร
                local isChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isChar = true; break end
                end
                if not isChar then
                    table.insert(items, primary)
                end
            end
        end
    end
    return items
end

local function runVacuum()
    if not Config.VacuumOn then return end
    local char = LocalPlayer.Character
    if not char then return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local myPos = myHrp.Position
    local items = findDroppedItems()

    for _, item in ipairs(items) do
        local pos = item.Position
        local dist = (pos - myPos).Magnitude
        if dist <= Config.VacuumRange then
            -- ดึงเข้าหาตัว
            pcall(function()
                if item:IsA("BasePart") then
                    item.CFrame = CFrame.new(myPos + Vector3.new(
                        math.random(-2, 2), 1, math.random(-2, 2)))
                end
            end)
        end
    end
end

